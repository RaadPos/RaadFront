# Copy this file to .env.local and fill in real values.
# SERVER-ONLY: no NEXT_PUBLIC_ prefix, so these are never exposed to the browser.
# Source: Supabase Dashboard → Settings → API
#
# The web storefront only calls rpc_public_storefront (granted to anon), so the
# ANON key is sufficient — no service-role key is required.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...your-anon-key...

# Optional: shared secret for POST /api/revalidate (cache busting on publish).
REVALIDATE_SECRET=change-me-to-a-long-random-string
